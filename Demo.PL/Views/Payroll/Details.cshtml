@model PayrollDetailsViewModel

@{
    ViewData["Title"] = $"Bảng lương {Model.Period.Name}";
    var canEdit = User.CanEditContent();
    var isClosed = Model.Period.Status == PayrollStatus.Closed;
}

<h1>Bảng lương kỳ @Model.Period.Name</h1>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="text-muted">Trạng thái</h6>
                @if (isClosed)
                {
                    <span class="badge badge-success p-2">Đã chốt</span>
                }
                else
                {
                    <span class="badge badge-warning p-2">Nháp</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="text-muted">Số nhân viên</h6>
                <h4 class="mb-0">@Model.Period.EmployeeCount</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="text-muted">Tổng quỹ lương</h6>
                <h4 class="mb-0">@Model.Period.TotalNetSalary.ToString("N0") đ</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body text-center">
                <h6 class="text-muted">Ngày chốt</h6>
                <h6 class="mb-0">@(Model.Period.ClosedDate?.ToString("dd/MM/yyyy") ?? "Chưa chốt")</h6>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
    <a asp-action="ExportExcel" asp-route-id="@Model.Period.Id" class="btn btn-success">
        <i class="fas fa-file-excel"></i> Xuất Excel
    </a>

    @if (canEdit && !isClosed)
    {
        <form asp-action="Close" asp-route-id="@Model.Period.Id" method="post" class="d-inline"
              onsubmit="return confirm('Chốt bảng lương? Sau khi chốt sẽ không thể điều chỉnh.');">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-lock"></i> Chốt bảng lương
            </button>
        </form>
    }
</div>

@if (Model.Payslips.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().EmployeeName)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().DepartmentName)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().BaseSalary)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().Allowance)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().Bonus)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().Deduction)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().Tax)</th>
                <th>@Html.DisplayNameFor(M => M.Payslips.First().NetSalary)</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payslip in Model.Payslips)
            {
                <tr>
                    <td>@payslip.EmployeeName</td>
                    <td>@payslip.DepartmentName</td>
                    <td>@payslip.BaseSalary.ToString("N0")</td>
                    <td>@payslip.Allowance.ToString("N0")</td>
                    <td>@payslip.Bonus.ToString("N0")</td>
                    <td>@payslip.Deduction.ToString("N0")</td>
                    <td>@payslip.Tax.ToString("N0")</td>
                    <td><strong>@payslip.NetSalary.ToString("N0")</strong></td>
                    <td>
                        <a asp-action="Payslip" asp-route-id="@payslip.Id" class="btn btn-info btn-sm">
                            <i class="fas fa-receipt"></i> Phiếu lương
                        </a>
                        @if (canEdit && !isClosed)
                        {
                            <a asp-action="EditPayslip" asp-route-id="@payslip.Id" class="btn btn-success btn-sm">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-dark">
                <th colspan="8">Tổng cộng</th>
                <th>@Model.Payslips.Sum(P => P.NetSalary).ToString("N0") đ</th>
            </tr>
        </tfoot>
    </table>
}
else
{
    <div class="alert alert-warning">Kỳ lương này chưa có phiếu lương nào.</div>
}
