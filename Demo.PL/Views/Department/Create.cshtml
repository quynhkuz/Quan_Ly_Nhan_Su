@model Department
@{
    ViewData["Title"] = "Thêm phòng ban";
}

<h1>Thêm phòng ban</h1>

<br/>
<br/>

<form asp-action="Create">
    <div asp-validation-summary="All"></div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Code"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>

    </div>
     <div class="form-group">
        <label class="col-form-lable" asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>

    </div>
     <div class="form-group">
        <label class="col-form-lable" asp-for="DateOfCreation"></label>
        <input asp-for="DateOfCreation" class="form-control" />

    </div>

    <input type="submit" value="Thêm" class="btn btn-primary" /> |
    <a asp-action="Index" class="btn btn-light">Quay lại danh sách</a>

</form>
