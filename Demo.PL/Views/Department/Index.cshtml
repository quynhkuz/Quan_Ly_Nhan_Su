@model IEnumerable<Department>

@{
    ViewData["Title"] = "Danh sách phòng ban";
    var canEdit = User.CanEditContent();
}

<h1>Danh sách phòng ban</h1>

<br/>
<br/>

@if (canEdit)
{
    <a asp-controller="Department" asp-action="Create" class="btn btn-primary">Thêm phòng ban mới</a>

    <br/>
    <br/>
}

@if(Model.Count() > 0)
{
    <table class="table tbale-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(D => D.Code)</th>
                <th>@Html.DisplayNameFor(D => D.Name)</th>
                <th>@Html.DisplayNameFor(D => D.DateOfCreation)</th>
                <th>Chi tiết</th>
                @if (canEdit)
                {
                    <th>Sửa</th>
                    <th>Xoá</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@DisplayNames.Department(department.Name)</td>
                    <td>@department.DateOfCreation</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-warning">
                            <i class="fas fa-eye"></i>
                            Chi tiết
                        </a>
                    </td>
                    @if (canEdit)
                    {
                        <partial name="_EditButtonsPartial" model="@department.Id.ToString()" />
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="mt-4 alert alert-warning">
        <h3>Không có phòng ban nào :(</h3>
    </div>
}
