@model Department
@{
    ViewData["Title"] = "Chi tiết phòng ban";
    var canEdit = User.CanEditContent();
}

<h1>Chi tiết phòng ban</h1>

<br />
<br />

<div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Code"></label>
        <input asp-for="Code" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Name"></label>
        <input asp-for="Name" class="form-control" readonly/>

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="DateOfCreation"></label>
        <input asp-for="DateOfCreation" class="form-control" readonly/>

    </div>

    @if (canEdit)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Sửa</a>
    }
    <a asp-action="Index" class="btn btn-light">Quay lại danh sách</a>

</div>
