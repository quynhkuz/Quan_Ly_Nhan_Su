@model UserViewModel
@using Demo.PL.Helpers

@{
    ViewData["Title"] = "Chi tiết người dùng";
    var canManage = User.IsInRole(Roles.Admin);
}

<h1>Chi tiết người dùng</h1>

<br />
<br />

<div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="UserName"></label>
        <input asp-for="UserName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="FName"></label>
        <input asp-for="FName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="LName"></label>
        <input asp-for="LName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Email"></label>
        <input asp-for="Email" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Roles"></label>
        <input value="@string.Join(", ", Model.Roles.Select(DisplayNames.Role))" class="form-control" readonly />

    </div>

    @if (canManage)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Sửa</a>
    }
    <a asp-action="Index" class="btn btn-light">Quay lại danh sách</a>

</div>
