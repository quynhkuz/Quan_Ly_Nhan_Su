@model UserViewModel

@{
    ViewData["Title"] = "Xoá người dùng";
}

<h1>Bạn có chắc muốn xoá người dùng này?</h1>

<br />
<br />

<form asp-action="Delete">
    <div asp-validation-summary="All"></div>

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label class="col-form-lable" asp-for="UserName"></label>
        <input asp-for="UserName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="FName"></label>
        <input asp-for="FName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="LName"></label>
        <input asp-for="LName" class="form-control" readonly />

    </div>
    <div class="form-group">
        <label class="col-form-lable" asp-for="Email"></label>
        <input asp-for="Email" class="form-control" readonly />

    </div>

    <input type="submit" value="Xoá" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>

</form>
