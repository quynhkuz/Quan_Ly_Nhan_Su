@model IEnumerable<UserViewModel>
@using Demo.PL.Helpers

@{
    ViewData["Title"] = "Danh sách người dùng";
    var canManage = User.IsInRole(Roles.Admin);
}

<h1>Danh sách người dùng</h1>

<br />
<br />

@if (canManage)
{
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus"></i>
            Thêm người dùng
        </a>
    </div>
}

<div class="row justify-content-center align-items-center mt-5">
    <form asp-action="Index" class="row col-8 offset-2" id="searchForm">
        <div class="col-8">
            <input type="text" class="form-control" name="email" placeholder="Tìm theo email" />
        </div>
        <div class="col-4">
            <input type="submit" value="Tìm kiếm" class="btn btn-success" />
        </div>

    </form>
</div>

<br />

@if (Model.Count() > 0)
{

    <table class="table tbale-striped table-hover">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(U => U.Id)</th>
                <th>@Html.DisplayNameFor(U => U.UserName)</th>
                <th>@Html.DisplayNameFor(U => U.FName)</th>
                <th>@Html.DisplayNameFor(U => U.LName)</th>
                <th>@Html.DisplayNameFor(U => U.Email)</th>
                <th>@Html.DisplayNameFor(U => U.PhoneNumber)</th>
                <th>@Html.DisplayNameFor(U => U.Roles)</th>
                <th>Chi tiết</th>
                @if (canManage)
                {
                    <th>Sửa</th>
                    <th>Xoá</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>

                    <td>@Html.DisplayFor(M => user.Id)</td>
                    <td>@Html.DisplayFor(M => user.UserName)</td>
                    <td>@Html.DisplayFor(M => user.FName)</td>
                    <td>@Html.DisplayFor(M => user.LName)</td>
                    <td>@Html.DisplayFor(M => user.Email)</td>
                    <td>@Html.DisplayFor(M => user.PhoneNumber)</td>
                    <td>@string.Join(", ", user.Roles.Select(DisplayNames.Role))</td>

                    <td>
                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-warning">
                            <i class="fas fa-eye"></i>
                            Chi tiết
                        </a>
                    </td>
                    @if (canManage)
                    {
                        <partial name="_ButtonsPartial" model="@user.Id" />
                    }
                </tr>
            }
        </tbody>
    </table>

}
else
{
    <div class="mt-4 alert alert-warning">
        <h3>Không có người dùng nào :(</h3>
    </div>
}
