@model EmployeeViewModel
@{
    ViewData["Title"] = "Xoá nhân viên";
}

<h1>Bạn có chắc muốn xoá nhân viên này?</h1>

<br />
<br />

<form asp-action="Delete">

    <div asp-validation-summary="ModelOnly"></div>
    <partial name="PartialViews/DetailsDeleteEmpPartial" />

    <input type="hidden" asp-for="ImageName" />

    <input type="submit" value="Xoá" class="btn btn-danger" /> |
    <a asp-action="Index" class="btn btn-secondary">Huỷ</a>

</form>
