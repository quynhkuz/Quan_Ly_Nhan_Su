@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="ResetPassword" method="post">
			<div asp-validation-summary="All"></div>
			<input class="text" asp-for="NewPassword" placeholder="Mật khẩu mới" required="">
			<input class="text w3lpass" asp-for="ConfirmNewPassword" placeholder="Xác nhận mật khẩu mới" required="">

			<input type="submit" value="Đặt lại mật khẩu">
		</form>
	</div>
</div>


@section ValidationScriptSection{
	<partial name="_ValidationScriptsPartial" />
}
