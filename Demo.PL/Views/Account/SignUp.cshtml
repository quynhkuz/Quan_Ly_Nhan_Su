@model SignUpViewModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}



<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="SignUp">
			<div asp-validation-summary="All"></div>
			<input class="text" asp-for="FName" placeholder="Tên" required="">
			<br/>
			<input class="text" asp-for="LName" placeholder="Họ" required="">
			<br />
			<input class="text" asp-for="UserName" placeholder="Tên đăng nhập" required="">
			<input class="text email" asp-for="Email" placeholder="Email" required="">
			<input class="text" asp-for="Password" placeholder="Mật khẩu" required="">
			<input class="text w3lpass" asp-for="ConfirmPassword" placeholder="Xác nhận mật khẩu" required="">
			<div class="wthree-text">
				<label class="anim">
					<input asp-for="IsAgree" class="checkbox" required="">
					<span>Tôi đồng ý với các điều khoản</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="ĐĂNG KÝ">
		</form>
		<p>Đã có tài khoản? <a asp-action="SignIn"> Đăng nhập ngay!</a></p>
	</div>
</div>


@section ValidationScriptSection{
	<partial name="_ValidationScriptsPartial" />
}
