@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<br />

<div class="row">
    <div class="col-md-3">
        <div class="card border-primary mb-4">
            <div class="card-body text-center">
                <i class="fas fa-users fa-2x text-primary mb-2"></i>
                <h5 class="card-title">Tổng nhân viên</h5>
                <h2 class="mb-0">@Model.TotalEmployees</h2>
                <small class="text-muted">@Model.ActiveEmployees đang làm việc</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success mb-4">
            <div class="card-body text-center">
                <i class="fas fa-building fa-2x text-success mb-2"></i>
                <h5 class="card-title">Phòng ban</h5>
                <h2 class="mb-0">@Model.TotalDepartments</h2>
                <small class="text-muted">đang quản lý</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning mb-4">
            <div class="card-body text-center">
                <i class="fas fa-calculator fa-2x text-warning mb-2"></i>
                <h5 class="card-title">Kỳ lương đã chốt</h5>
                <h2 class="mb-0">@Model.ClosedPeriods</h2>
                <small class="text-muted">kỳ lương</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-danger mb-4">
            <div class="card-body text-center">
                <i class="fas fa-money-bill-wave fa-2x text-danger mb-2"></i>
                <h5 class="card-title">Lương trung bình</h5>
                <h2 class="mb-0">@Model.AverageSalary.ToString("N0") đ</h2>
                <small class="text-muted">trên 1 nhân viên</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Lương theo phòng ban</h5>
            </div>
            <div class="card-body">
                <canvas id="salaryChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Kỳ lương gần đây</h5>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.LatestPeriods.Any())
                {
                    foreach (var period in Model.LatestPeriods)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a asp-controller="Payroll" asp-action="Details" asp-route-id="@period.Id">@period.Name</a>
                            @if (period.Status == PayrollStatus.Closed)
                            {
                                <span class="badge badge-success">Đã chốt</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Nháp</span>
                            }
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">Chưa có kỳ lương nào</li>
                }
            </ul>
            <div class="card-footer">
                <strong>Tổng quỹ kỳ gần nhất:</strong> @(Model.LatestPeriodTotal.ToString("N0")) đ
                <span class="text-muted">(@(Model.LatestPeriodName ?? "chưa tính"))</span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body text-center">
                <i class="fas fa-users fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Nhân viên</h5>
                <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem danh sách</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body text-center">
                <i class="fas fa-building fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Phòng ban</h5>
                <a asp-controller="Department" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem danh sách</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body text-center">
                <i class="fas fa-money-check-alt fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Bảng lương</h5>
                <a asp-controller="Payroll" asp-action="Index" class="btn btn-outline-primary btn-sm">Tính lương</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-body text-center">
                <i class="fas fa-chart-bar fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Báo cáo</h5>
                <a asp-controller="Report" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem báo cáo</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalaryByDepartment.Select(S => S.DepartmentName)));
        var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalaryByDepartment.Select(S => (double)S.TotalSalary)));

        new Chart(document.getElementById('salaryChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Tổng lương (đ)',
                    data: data,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function (value) { return value.toLocaleString('vi-VN'); }
                        }
                    }
                }
            }
        });
    </script>
}
